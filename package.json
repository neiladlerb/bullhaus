{
  "name": "bullhaus",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:start": "node scripts/db.mjs",
    "db:migrate": "pnpm --filter @bullhaus/db migrate",
    "db:seed": "pnpm --filter @bullhaus/db seed",
    "dev": "pnpm --filter @bullhaus/backoffice dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "evals": "echo \"Sin evals todavía: el agente de WhatsApp aún no existe\""
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "sharp", "esbuild", "embedded-postgres", "@embedded-postgres/windows-x64"]
  }
}
