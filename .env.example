# Base de datos local (la levanta `pnpm db:start`)
DATABASE_URL=postgresql://make:make@localhost:5433/make?schema=public

# Carpeta de archivos en desarrollo (fotos públicas y documentos privados)
STORAGE_DIR=../../storage

# Usuario administrador inicial que crea `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@bullhaus.local
SEED_ADMIN_PASSWORD=
