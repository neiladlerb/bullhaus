# Base de datos. En local la levanta `pnpm db:start` y las dos URL son la misma.
# En Supabase: DATABASE_URL = pooler (puerto 6543, ?pgbouncer=true&connection_limit=1),
# DIRECT_URL = conexión directa (puerto 5432), la que usan las migraciones.
DATABASE_URL=postgresql://bullhaus:bullhaus@localhost:5433/bullhaus?schema=public
DIRECT_URL=postgresql://bullhaus:bullhaus@localhost:5433/bullhaus?schema=public

# Archivos en desarrollo (fotos públicas y documentos privados). Se ignora si hay Supabase.
STORAGE_DIR=../../storage

# Supabase Storage (obligatorio en Vercel). La clave de servicio solo va en el servidor,
# nunca con prefijo NEXT_PUBLIC_. Ambos buckets se crean como privados.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=fotos
SUPABASE_BUCKET_PRIVATE=documentos

# Usuario administrador inicial que crea `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@bullhaus.local
SEED_ADMIN_PASSWORD=
